[resource]
script = ExtResource("1_item")
id = "lanterna"
nome = "Lanterna"
descricao = "Lanterna pequena a pilha, com uma alça de pulso, que o Gabriel leva na mão. Ilumina à frente, mas a luz chama a atenção dos robôs. Quando a bateria acabar, troque a pilha."
