[resource]
script = ExtResource("1_item")
id = "espelho"
nome = "Caco de espelho"
descricao = "Um caco do espelho do provador. Usado na hora certa, de frente para o farol vermelho da Sentinela, rebate a luz e ofusca quem estiver na linha. Fora de hora, só deixa você mais visível."
