[resource]
script = ExtResource("1_item")
id = "walkman"
nome = "Walkman da Clarice"
descricao = "O walkman laranja da Clarice, com a fita dela e sem o fone: sem fone, ele grita. Largado no chão, toca por 15 segundos e os robôs vão ver. Cada uso gasta um quarto da pilha. Dá para pegar de volta."
icone = ExtResource("2_icone")
sprite_chao = ExtResource("3_chao")
imagem_detalhe = ExtResource("4_detalhe")
equipavel = true
cena_gadget = ExtResource("5_gadget")
cena_largado = ExtResource("6_largado")
