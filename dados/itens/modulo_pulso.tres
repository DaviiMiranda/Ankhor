[resource]
script = ExtResource("1_item")
id = "modulo_pulso"
nome = "Módulo de pulso"
descricao = "O módulo de sonar que o Zane encaixou no notebook. Sem nada para invadir por perto, o botão do notebook solta um pulso: mostra corredores e robôs por um instante. Gasta bateria e faz barulho."
icone = ExtResource("2_icone")
sprite_chao = ExtResource("3_chao")
imagem_detalhe = ExtResource("4_detalhe")
