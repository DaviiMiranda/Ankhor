			"vai_para": "posto"
		},
		"cima": {
			"falas": [
				{
					"quem": "Rafael",
					"retrato": "rafael/rafael_retrato_normal",
					"texto": "Lá em cima o teto caiu em vários pontos. Onde bate a lua, a máquina de lá te enxerga de longe."
				},
				{
					"quem": "Rafael",
					"retrato": "rafael/rafael_retrato_normal",
					"texto": "Anda pelo escuro e entra nas salas pra despistar."
