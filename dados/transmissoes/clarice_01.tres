[gd_resource type="Resource" script_class="Transmissao" format=3]

[ext_resource type="Script" path="res://scripts/sistemas/transmissao.gd" id="1_transmissao"]

[resource]
script = ExtResource("1_transmissao")
id = "clarice_01"
falante = "CLARICE (telefone)"
falas = PackedStringArray("Alô? Alô! Finalmente. Sabe quantas vezes eu liguei pra esse balcão? Nem eu sei.", "Não desliga. O sistema acusou a grade da ala leste subindo. Foi você, né?", "Achou meu disquete. Viu? Eu disse que guardava as senhas. Totalmente organizada.", "A porta do fim da ala leste é eletrônica. Segura aí... Pronto. Destranquei.", "Agora sai da Biblioteca. E não fica embaixo das luzes, sério. Eu ligo de novo. Fui!")
titulo_anotacao = "Clarice, 1994"
anotacao = "A Clarice está viva! Ligou para o telefone do balcão e destrancou pelo sistema a porta de saída da ala leste.

Disse para não ficar embaixo das luzes. Vai ligar de novo."
