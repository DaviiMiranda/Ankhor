[gd_resource type="Resource" script_class="Transmissao" format=3]

[ext_resource type="Script" path="res://scripts/sistemas/transmissao.gd" id="1_transmissao"]

[resource]
script = ExtResource("1_transmissao")
id = "clarice_biblioteca_01"
falante = "CLARICE (rádio)"
falas = PackedStringArray("Chhh... Ei, você aí no balcão. Isso aqui pega? Tô falando com você mesmo.", "Sou a Clarice. Calma: tô na mesma frequência, só não tô aí do seu lado.", "O Henrique tá com as câmeras e vê o salão daí. Uma parte, a que ainda funciona.", "Tem um robô de um olho só fazendo a ronda. Antes de virar, ele dá um bipe.", "Ouviu o bipe, se esconde atrás das estantes. Ele enxerga pouco.", "Eu fico na escuta. Qualquer coisa, chama. E não confia nas luzes.")
titulo_anotacao = "Clarice, 1990"
anotacao = "Uma voz no rádio: a Clarice. O Henrique vê o salão pelas câmeras e avisa as rondas por ela.
- O robô de um olho só dá um bipe antes de virar.
- Ouviu o bipe: se esconder atrás das estantes."
