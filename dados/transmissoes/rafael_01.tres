[gd_resource type="Resource" script_class="Transmissao" format=3]

[ext_resource type="Script" path="res://scripts/sistemas/transmissao.gd" id="1_transmissao"]

[resource]
script = ExtResource("1_transmissao")
id = "rafael_01"
falante = "RAFAEL (rádio)"
falas = PackedStringArray("Chhh... Alô? Alô, alguém na escuta? Câmbio.", "Aqui é o Seu Rafael, da vigilância noturna. Quem é que tá na Biblioteca a essa hora?", "Não liga pra essa bagunça não, rapaz. Isso aqui não é 3026 coisa nenhuma. É reforma.", "Presta atenção: tem um bicho de metal que faz a ronda aí dentro.", "Antes de virar, ele dá um bipe. Ouviu o bipe, se esconde.", "Atrás das estantes do acervo, lá no fundo, ele não enxerga.", "Toda noite é a mesma coisa. Toda noite. Câmbio, desligo.")
titulo_anotacao = "Rafael, 2008"
anotacao = "Segurança da Unifor em 2008. Fala pelo rádio e acha que tudo isso é reforma.

- O robô da Biblioteca dá um bipe antes de virar.
- Ouviu o bipe: se esconder atrás das estantes do acervo, no fundo da sala."
