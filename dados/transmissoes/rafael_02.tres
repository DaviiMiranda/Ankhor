[ext_resource type="Script" path="res://scripts/sistemas/transmissao.gd" id="1_transmissao"]

[resource]
script = ExtResource("1_transmissao")
id = "rafael_02"
falante = "RAFAEL (rádio)"
falas = PackedStringArray("Chhh... Tá no acervo? Boa. No meio das estantes ninguém te vê.", "Só não corre, viu? Esses bichos escutam passo de longe. Câmbio.")
titulo_anotacao = "Rafael, 2008"
anotacao = "Rafael de novo: entre as estantes do acervo ninguém vê. Não correr: os robôs escutam os passos de longe.

Ele falou como se estivesse me vendo."
