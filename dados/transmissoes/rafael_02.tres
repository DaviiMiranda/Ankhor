[gd_resource type="Resource" script_class="Transmissao" format=3]

[ext_resource type="Script" path="res://scripts/sistemas/transmissao.gd" id="1_transmissao"]

[resource]
script = ExtResource("1_transmissao")
id = "rafael_02"
falante = "RAFAEL (rádio)"
falas = PackedStringArray("Chhh... Subiu? Então presta atenção, macho. A máquina daqui de cima é outra. Essa enxerga longe.", "Ela gosta de parar debaixo dos buracos do teto, onde bate a lua. Ali ela te vê de longe.", "Passa pelo escuro, colado nas portas. E não fica parado no claro. Câmbio.")
titulo_anotacao = "Seu Rafael, 2008"
anotacao = "O robô do 1º andar enxerga longe e para debaixo dos buracos do teto, onde bate a lua.
- Passar pelo escuro, perto das portas."
