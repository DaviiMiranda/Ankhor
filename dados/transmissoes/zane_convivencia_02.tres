[gd_resource type="Resource" script_class="Transmissao" format=3]

[ext_resource type="Script" path="res://scripts/sistemas/transmissao.gd" id="1_transmissao"]

[resource]
script = ExtResource("1_transmissao")
id = "zane_convivencia_02"
falante = "ZANE (rádio)"
falas = PackedStringArray("Chhh... Boa, Gabriel! A comutação trifásica funcionou e a trava da rampa liberou!", "Mas ó: a energia ligou também os holofotes perimetrais do pátio, e as Sentinelas mudaram de rota. Fica nas sombras até a rampa do subsolo!")
titulo_anotacao = "Holofotes acesos e rampa destravada"
anotacao = "Armei o comutador da Gráfica. O Zane avisou pelo rádio que a comporta da Rampa do Subsolo destravou, mas os holofotes do pátio acenderam e mudaram a ronda das Sentinelas."
