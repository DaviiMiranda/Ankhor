[gd_resource type="Resource" script_class="Transmissao" format=3]

[ext_resource type="Script" path="res://scripts/sistemas/transmissao.gd" id="1_transmissao"]

[resource]
script = ExtResource("1_transmissao")
id = "zane_convivencia_02"
falante = "ZANE (rádio)"
falas = PackedStringArray("Chhh... Comutação trifásica da cozinha: correta. O elevador de carga do Churrasco Solar liberou.", "Efeito colateral: a energia acendeu os letreiros e os holofotes da cúpula, e as Sentinelas mudaram de rota. Fica nas sombras até o elevador.")
titulo_anotacao = "Letreiros acesos e elevador destravado"
anotacao = "Armei o comutador da cozinha da Pizzaria Quasar. O Zane avisou pelo rádio que o elevador de carga do Churrasco Solar destravou, mas os letreiros e os holofotes da cúpula acenderam e mudaram a ronda das Sentinelas."
