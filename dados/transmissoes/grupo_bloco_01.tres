[gd_resource type="Resource" script_class="Transmissao" format=3]

[ext_resource type="Script" path="res://scripts/sistemas/transmissao.gd" id="1_transmissao"]

[resource]
script = ExtResource("1_transmissao")
id = "grupo_bloco_01"
falante = "RÁDIO"
falas = PackedStringArray("Chhh... O Henrique viu o claviculário aberto. Contou os tracinhos, foi? Ponto pra você de novo, estudante.", "Conta de lousa. Nível primário.", "A 206 é o depósito! Tá na minha planta, com uma seta enorme!", "Ele não tá vendo a sua planta, Diana. Ninguém vê desenho pelo rádio.", "Mas tá desenhada! Lá dentro é estante pra todo lado, feito labirinto. E tem um daqueles autômatos baixinhos. O que escuta.", "Rastreador. Chama Rastreador. Mas é isso: lá dentro, pisa como se o chão fosse de vidro.", "Autômato, Rastreador, tanto faz! Se ele te ouvir, é o fim!", "Ela é sempre assim?", "Desde que chegou. Três dias de \"é o fim\". Até agora, nenhum fim.", "Ainda!")
falantes = PackedStringArray("CLARICE (rádio)", "GABRIEL (rádio)", "DIANA (rádio)", "CLARICE (rádio)", "DIANA (rádio)", "CLARICE (rádio)", "DIANA (rádio)", "GABRIEL (rádio)", "CLARICE (rádio)", "DIANA (rádio)")
titulo_anotacao = "Clarice e Diana, no rádio"
anotacao = "A chave do claviculário abre o depósito (206). Lá dentro tem estantes como um labirinto e um Rastreador, o robô que escuta: pisar devagar.
A Diana desenha o mapa e chama os robôs de autômatos. A Clarice já se acostumou com o drama."
