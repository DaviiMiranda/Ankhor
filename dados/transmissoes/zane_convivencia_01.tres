[gd_resource type="Resource" script_class="Transmissao" format=3]

[ext_resource type="Script" path="res://scripts/sistemas/transmissao.gd" id="1_transmissao"]

[resource]
script = ExtResource("1_transmissao")
id = "zane_convivencia_01"
falante = "ZANE (rádio)"
falas = PackedStringArray("Chhh... Gabriel. Seu rádio acusou a passarela do Centro de Convivência. Tô vendo o sinal daqui.", "A praça fica sob uma cúpula de vidro quebrada. Duas Sentinelas rondam as mesas, e o luar entrega qualquer um. Usa mesas, árvores e nichos pra cortar a visão.", "O elevador pro Bunker fica nos fundos do Churrasco Solar, sem energia. Na Tapioca Orbital, que é sala segura, a ordem de serviço diz onde está a célula.")
titulo_anotacao = "Zane no rádio: Centro de Convivência"
anotacao = "O Zane avisou pelo rádio que a praça de alimentação do Centro de Convivência tem duas Sentinelas sob a cúpula. Preciso usar mesas, árvores e nichos como cobertura, ler a ordem de serviço na Tapioca Orbital e achar a célula de energia para ligar o elevador de carga do Churrasco Solar."
