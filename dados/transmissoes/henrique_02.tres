script = ExtResource("1_transmissao")
id = "henrique_02"
falante = "HENRIQUE (rádio)"
falas = PackedStringArray("Chhh... Você entrou no acervo. O robô daí não enxerga bem. Ele escuta.", "Então não corre. Passo de corrida ele ouve de longe. Anda... devagar.")
