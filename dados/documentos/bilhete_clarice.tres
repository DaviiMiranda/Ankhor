[gd_resource type="Resource" script_class="Documento" format=3]

[ext_resource type="Script" path="res://scripts/itens/documento.gd" id="1_documento"]

[resource]
script = ExtResource("1_documento")
id = "bilhete_clarice"
titulo = "Bilhete colado no terminal"
autor = "Clarice, 1990"
papel = "caderno_clarice"
paginas = PackedStringArray("Se alguém ler isso: sou a Clarice, de 1990, Processamento de Dados. Rodei um programa no terminal da Biblioteca de madrugada e PUF, vim parar aqui. Totalmente surreal.

Descobri umas coisas. Os robôs não andam à toa: fazem sempre o mesmo caminho, que nem um programa em loop. Dá pra decorar.", "Os terminais pedem senha. Guardei as que achei no meu disquete. Uma delas abre a grade do salão, então não perde, meu filho.

Vou pro Bloco de salas. Se mais alguém chegou, me procura lá.", "Foi legal conversar com alguém, mesmo que seja com um papel, mas gente de verdade é melhor.

Não confie nas luzes. — Clarice

PS: se você for um robô, finge que não leu.")
anotacao = "Aluna de 1990. Os robôs repetem sempre o mesmo caminho: dá para decorar.

Guardou senhas num disquete. Uma delas abre a grade do salão.

Foi para o Bloco de salas e pediu que quem chegasse a procurasse lá. Escreveu: não confie nas luzes."
