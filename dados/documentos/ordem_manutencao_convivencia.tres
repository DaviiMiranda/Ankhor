[gd_resource type="Resource" script_class="Documento" format=3]

[ext_resource type="Script" path="res://scripts/itens/documento.gd" id="1_documento"]

[resource]
script = ExtResource("1_documento")
id = "ordem_manutencao_convivencia"
titulo = "Ordem de Manutenção Técnica (3026)"
autor = "Manutenção da Praça de Alimentação"
papel = "caderno_gabriel"
paginas = PackedStringArray("ORDEM DE SERVIÇO — PRAÇA DE ALIMENTAÇÃO

1. O elevador de carga do Churrasco Solar (acesso ao Bunker) depende do Quadro de Comutação da cozinha da Pizzaria Quasar.
2. A Célula de Energia reserva foi realocada para o gerador de emergência da câmara fria do Self Nebulosa (ala oeste).
3. Ao armar o comutador trifásico, regule as 3 fases para que setores vizinhos (N-L, L-S, S-O, O-N e diagonal N-S) não usem a mesma fase.")
anotacao = "Ordem de serviço na Tapioca Orbital: a Célula de Energia que alimenta o comutador da cozinha da Pizzaria Quasar está na câmara fria do Self Nebulosa. No comutador, setores ligados não podem ter a mesma fase."
