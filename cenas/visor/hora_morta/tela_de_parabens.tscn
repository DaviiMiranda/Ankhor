[node name="Paragrafo1" type="Label" parent="Historia"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.84, 0.9, 1)
text = "Este jogo é baseado numa teoria sobre o que aconteceu com a Nave 67."
