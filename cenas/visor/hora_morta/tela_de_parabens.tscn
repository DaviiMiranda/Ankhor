autowrap_mode = 2

[node name="Paragrafo2" type="Label" parent="Historia"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.84, 0.9, 1)
text = "A Nave 67 partiu para um planeta distante, e lá a tripulação desapareceu."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Paragrafo3" type="Label" parent="Historia"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.84, 0.9, 1)
text = "Um único homem conseguiu fugir numa nave menor, mas não resistiu ao caminho de volta."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Paragrafo4" type="Label" parent="Historia"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.72, 0.3, 1)
text = "O que aconteceu com a Nave 67 continua sendo um grande mistério."
horizontal_alignment = 1
autowrap_mode = 2

