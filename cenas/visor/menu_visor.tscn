[sub_resource type="ShaderMaterial" id="ShaderMaterial_crt"]
shader = ExtResource("3_crt")
shader_parameter/forca_linhas = 0.18
shader_parameter/forca_vinheta = 0.6
shader_parameter/raio_cantos = 0.07
shader_parameter/proporcao = 1.3333
shader_parameter/linhas_na_altura = 72.0

[node name="MenuVisor" type="Control"]
layout_mode = 3
anchors_preset = 0
offset_right = 192.0
offset_bottom = 144.0
theme = ExtResource("2_tema")
script = ExtResource("1_menu")

[node name="Fundo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.035, 0.07, 0.1, 1)

[node name="Conteudo" type="VBoxContainer" parent="."]
layout_mode = 0
